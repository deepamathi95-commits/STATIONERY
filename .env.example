# Copy this file to ".env" (same folder as package.json) and fill in your own values. Never share .env.
PORT=3000
BASE_URL=http://localhost:3000
TOKEN_SECRET=put-a-long-random-text-here
ADMIN_KEY=choose-a-private-admin-password
# Orders move through the tracking steps automatically (demo timeline). Set to 0 to update orders by hand instead.
AUTO_TRACKING=1
# Google sign-in: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=
# Yahoo sign-in: developer.yahoo.com/apps (needs an https redirect URL)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Cards: Razorpay Dashboard > Test Mode > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Your own UPI ID for the Google Pay / PhonePe QR code
UPI_ID=deepamathi95@okhdfcbank
UPI_NAME=Smart Stationery
# Demo card form (accepts only the test card 4111 1111 1111 1111). Automatically on for localhost, off online. 0 = always off.
DEMO_PAYMENTS=
